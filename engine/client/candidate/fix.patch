+// display_mode_adapter_format (JKPro PES 2013, 2026-11-25): GetDisplayMode answers a display
+// (adapter) format, as the PE DXVK device does (D3D9SwapChainEx::GetDisplayModeEx: always
+// X8R8G8B8), never the back buffer format. Wine d3dx9 D3DXCheckTextureRequirements passes
+// mode.Format as the AdapterFormat of IDirect3D9::CheckDeviceFormat, and DXVK's
+// IsSupportedAdapterFormat (d3d9_monitor.cpp) accepts only A2R10G10B10, X8R8G8B8, X1R5G5B5 and
+// R5G6B5: with A8R8G8B8 (PES 2013 creates 960x600 fmt=21) every format check fails and every
+// D3DXCreateTextureFromFileInMemoryEx fails ("Couldn't find suitable texture parameters").
+static void testDisplayMode(IDirect3DDevice9Ex* dev) {
+  auto reset = [&](UINT w, UINT h, D3DFORMAT f) {
+    D3DPRESENT_PARAMETERS pp = { };
+    pp.BackBufferWidth = w; pp.BackBufferHeight = h; pp.BackBufferFormat = f; pp.BackBufferCount = 1; pp.Windowed = TRUE;
+    CHECK(dev->Reset(&pp) == D3D_OK, "display_mode: Reset %ux%u fmt %u", w, h, unsigned(f));
+  };
+  for (D3DFORMAT f : { D3DFMT_A8R8G8B8, D3DFMT_UNKNOWN, D3DFMT_X8R8G8B8, D3DFMT_R5G6B5 }) {
+    reset(960, 600, f);
+    D3DDISPLAYMODE m = { };
+    CHECK(dev->GetDisplayMode(0, &m) == D3D_OK, "display_mode: GetDisplayMode hr (bb fmt %u)", unsigned(f));
+    CHECK(m.Format == D3DFMT_X8R8G8B8, "display_mode_adapter_format: GetDisplayMode Format %u with back buffer fmt %u, expected X8R8G8B8 (22)", unsigned(m.Format), unsigned(f));
+    CHECK(m.Width == 960 && m.Height == 600 && m.RefreshRate == 60, "display_mode: %ux%u@%u", m.Width, m.Height, m.RefreshRate);
+    D3DDISPLAYMODEEX mx = { }; mx.Size = sizeof(mx);
+    D3DDISPLAYROTATION rot = D3DDISPLAYROTATION_90;
+    CHECK(dev->GetDisplayModeEx(0, &mx, &rot) == D3D_OK, "display_mode: GetDisplayModeEx hr");
+    CHECK(mx.Format == D3DFMT_X8R8G8B8 && rot == D3DDISPLAYROTATION_IDENTITY, "display_mode_adapter_format: GetDisplayModeEx Format %u with back buffer fmt %u", unsigned(mx.Format), unsigned(f));
+    IDirect3DSwapChain9* sc = nullptr;
+    D3DDISPLAYMODE sm = { };
+    CHECK(dev->GetSwapChain(0, &sc) == D3D_OK && sc && sc->GetDisplayMode(&sm) == D3D_OK, "display_mode: swap chain GetDisplayMode");
+    CHECK(sm.Format == D3DFMT_X8R8G8B8, "display_mode_adapter_format: swap chain GetDisplayMode Format %u with back buffer fmt %u", unsigned(sm.Format), unsigned(f));
+    if (sc) sc->Release();
+  }
+  reset(64, 64, D3DFMT_X8R8G8B8);
+}
